{
  "name": "musicview",
  "type": "module",
  "version": "0.2.14",
  "description": "YouTube 動画を音楽として聴くことに特化したデスクトッププレイヤー(実サイトラップ+広告ブロック)",
  "main": "electron/main.mjs",
  "author": "akagifreeez",
  "scripts": {
    "start": "electron electron/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "probe": "electron electron/main.mjs --probe",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.akagifreeez.musicview",
    "productName": "musicview",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "lib/**",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "musicview-${version}-portable.exe"
    }
  }
}
